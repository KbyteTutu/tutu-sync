# 复制为 .env 并填写。.env 含密钥，权限 600，不要提交。
#
# 管理令牌：签发/吊销主机、签发/删除 wg 节点、同步模型规范版、删除分享。
# 生成: openssl rand -base64 48
TUTU_MASTER_TOKEN=

# WGDashboard API Key（config.yaml 的 wg.dashboard.api_key 引用）
# 面板 Settings 最下方启用 API Key → Create 生成
WGDASHBOARD_API_KEY=

# 邮件服务（config.yaml 里 gmail 段引用 ${GMAIL_APP_PASSWORD} / ${LLM_API_KEY}）
# Gmail 应用专用密码: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=
LLM_API_KEY=
