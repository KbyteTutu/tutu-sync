{
  "name": "tutu-sync",
  "version": "2.0.0",
  "description": "tutu-mcp — 中心式个人 MCP 服务组（主机引导 / WireGuard / pi 模型与扩展 / 文件分享 / 邮件）",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && cp src/services/pi/sync.py dist/services/pi/sync.py",
    "start": "node dist/main.js",
    "test": "node --test dist/tests/*.test.js",
    "test:py": "python3 -B -m unittest discover -s src/services/pi -p 'test_*.py' -v"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.0.3",
    "html-to-text": "^10.0.1",
    "imapflow": "^2.9.1",
    "mailparser": "^3.12.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.7.2",
    "typebox": "^1.4.3",
    "typescript": "^5.9.3"
  }
}
